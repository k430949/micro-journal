{
  // Dev container for Micro Journal (React + Vite frontend, Express + SQLite backend).
  // Works with Podman (VS Code setting "dev.containers.dockerPath": "podman") or Docker.
  // --network=host: use the host/VM network (the default container network times out on the UPM network).
  // NODE_EXTRA_CA_CERTS / SSL_CERT_FILE: Node, npm and other tools use the system certificates,
  // which include the Zscaler root (see Dockerfile).
  // forwardPorts: 5173 = Vite dev server (frontend), 3000 = Express API (backend).
  // postCreateCommand: npm install in every app folder that has a package.json (skips on an empty repo).
  "name": "micro-journal",
  "build": { "dockerfile": "Dockerfile", "options": ["--network=host"] },
  "runArgs": ["--network=host"],
  "containerUser": "node",
  "remoteUser": "node",
  "containerEnv": {
    "HOME": "/home/node",
    "NODE_EXTRA_CA_CERTS": "/etc/ssl/certs/ca-certificates.crt",
    "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"
  },
  "forwardPorts": [5173, 3000],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite)", "onAutoForward": "openBrowser" },
    "3000": { "label": "Backend (Express API)", "onAutoForward": "notify" }
  },
  "postCreateCommand": "git config --global --add safe.directory '*' && for d in . frontend backend client server; do [ -f \"$d/package.json\" ] && (cd \"$d\" && npm install); done; true",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "qwtel.sqlite-viewer",
        "humao.rest-client",
        "github.copilot",
        "github.copilot-chat"
      ],
      "settings": {
        "files.insertFinalNewline": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib",
        "files.exclude": {
          "**/node_modules": true
        }
      }
    }
  }
}